{
  "name": "toka",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "husky",
    "build:linux": "node bin/build.mjs linux",
    "build:mac": "node bin/build.mjs mac",
    "build": "tsc && node bin/build-frontend.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check package.json package-lock.json eslint.config.js .prettierrc.json .github/workflows/pr-quality.yml",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration.mjs all",
    "test:integration:real-provider": "node scripts/run-integration.mjs plocate",
    "test:integration:native": "node scripts/run-integration.mjs native",
    "build:integration": "VITE_E2E=1 npm run tauri build -- --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "build:integration:native": "VITE_E2E=1 npm run tauri build -- --debug --no-bundle --features native-e2e --config src-tauri/tauri.e2e.conf.json",
    "plocate:configure": "sudoedit /usr/local/sbin/update-plocate-media && printf '\\nTo rebuild the plocate index now, run: sudo systemctl start plocate-updatedb.service\\n'",
    "test:watch": "vitest",
    "check:precommit:staged": "lint-staged",
    "check:precommit": "npm run lint && npm run format:check",
    "check:pr": "npm run check:precommit && npm run build && npm test && npm run rust:test && npm run rust:clippy",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/native-utils": "2.5.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@wdio/native-utils": "$@wdio/native-utils"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,html,json,jsonc,md,yml,yaml}": "prettier --write",
    "*.rs": "rustfmt --check --edition 2021"
  }
}
